{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "microtool-hub": {
      "type": "streamable-http",
      "url": "https://microtool-hub.getvoroa.com/mcp",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "provided",
              "clientId": "chatgpt_client_microtool",
              "tokenEndpointAuthMethod": "none"
            },
            "authorizationUrl": "https://microtool-hub.getvoroa.com/oauth/authorize",
            "tokenUrl": "https://microtool-hub.getvoroa.com/oauth/token",
            "registrationUrl": "https://microtool-hub.getvoroa.com/oauth/register",
            "baseScopes": [
              "tools:read",
              "projects:create",
              "projects:read",
              "files:write",
              "files:delete",
              "projects:publish"
            ]
          }
        }
      }
    }
  }
}
